# .NET build output
**/bin/
**/obj/
**/publish/
**/*-publish/
**/wwwroot/*
!**/wwwroot/.gitkeep

# .NET user and IDE files
**/*.csproj.user
**/*.suo
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Angular and Node output
**/node_modules/
**/dist/
**/.angular/cache/
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local configuration and secrets
**/appsettings.Local.json
**/appsettings.Production.json
**/*.local.json

# OS files
.DS_Store
Thumbs.db

# Local deployment archives
*.zip
*.tar.gz
