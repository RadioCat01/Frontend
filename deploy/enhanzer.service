[Unit]
Description=Enhanzer Angular and ASP.NET Core application
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/enhanzer
ExecStart=/opt/enhanzer/EnhanzerAPI
Restart=always
RestartSec=10
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
EnvironmentFile=/etc/enhanzer/enhanzer.env
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target